# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase service account (contains secrets)
service-account.json

# local exports
/local_exports/

.vercel

# Papelones de sesiones de trabajo (capturas de "diff", logs de pruebas a mano):
# no forman parte del programa. Van por nombre exacto para no tapar nada real.
/_agent_diff.txt
/agent_diff_preview.txt
/diff_agent.txt
/diff_preview.txt
/tsc_out.txt
/sync-agent/agent-manual.log
/sync-agent/agent-manual.err
/sync-agent/agent.err
# Logs de dev redirigidos a disco y scripts temporales de pruebas a mano:
# no forman parte del programa.
/dev-stdout*.txt
/dev-stderr*.txt
/temp_run_*.ts

# Copia de respaldo del acceso directo del autostart del agente (se CONSERVA en
# disco hasta confirmar que el arranque unico es estable; solo se saca de git).
/startup-backup/

# ── Ruido del watcher/agente de 3C (se regenera solo; no es fuente) ──────────
# Excel exportados, índices/cachés, manifiesto de corrida y logs: cambian en
# cada sincronización. Con la retención de 3C (1 Excel por informe) se borran
# solos; no van a git.
/automation-watcher/3c_exports/*.xls
/automation-watcher/3c_exports/*.xlsx
/automation-watcher/3c_exports/_last_export.json
/automation-watcher/cache/
/automation/logs/
/sync-agent/.agent.lock
/sync-agent/agent.log
/sync-agent/agent-wake.log
/sync-agent/bridge.log
/sync-agent/agent-autostart.log
/sync-agent/agent-stderr.log
/sync-agent/agent-stdout.log
/sync-agent/agent.err.log
/sync-agent/logs/

