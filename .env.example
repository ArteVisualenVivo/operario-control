# ====== Cloudinary (gratuito, sin autenticación del cliente) ======
# Cloudinary está configurado con Cloud Name: dpcdsorty, preset upload:
# `operario_blueprints` (tipo `upload`, público). El upload desde el navegador
# NO requiere claves.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dpcdsorty
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ====== Gemini (opcional: parser con LLM) ======
# Solo necesario si se habilita el parser Gemini (free tier ~cada 60 usos/día).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
